# nginx substitutes ${BACKEND_HOST} and ${BACKEND_PORT} from the environment at startup,
# so the backend address is configuration, never something baked into the image.

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    client_max_body_size 10m;

    location / {
        try_files $uri $uri/ =404;
    }

    # Everything the browser calls goes through here to the backend.
    location /api/ {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT}/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 60s;
    }

    location = /ready {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT}/ready;
    }
}
